#!/bin/bash

# git_auto.sh - Automated git operations with best practices

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}=== Git Auto Commit Tool ===${NC}"

# Check if we're in a git repository
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${NC}"
    exit 1
fi

# Show current status
echo -e "${YELLOW}Current status:${NC}"
git status -s

# Prompt for commit message
read -p "Enter commit message: " commit_message

if [ -z "$commit_message" ]; then
    commit_message="Auto-commit: $(date '+%Y-%m-%d %H:%M:%S')"
    echo -e "${YELLOW}Using default message: ${commit_message}${NC}"
fi

# Add all changes
echo -e "${GREEN}Adding all changes...${NC}"
git add .

# Commit
echo -e "${GREEN}Committing...${NC}"
git commit -m "$commit_message"

# Push if requested
read -p "Push to remote? (y/n): " push_choice
if [ "$push_choice" = "y" ] || [ "$push_choice" = "Y" ]; then
    # Get current branch
    branch=$(git branch --show-current)
    echo -e "${GREEN}Pushing to origin/${branch}...${NC}"
    git push origin $branch
else
    echo -e "${YELLOW}Commit done locally. Push later with: git push${NC}"
fi

echo -e "${GREEN}Done!${NC}"
